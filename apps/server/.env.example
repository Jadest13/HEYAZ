NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/postgres
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://heyaz:heyaz@127.0.0.1:5432/heyaz
AUTH_MODE=development
DEV_AUTH_TOKEN=heyaz-local-development-only-token
COACH_MODE=mock
# Production requires DATABASE_DRIVER=postgres and AUTH_MODE=oidc.
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_AUDIENCE=heyaz-api
# OIDC_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
